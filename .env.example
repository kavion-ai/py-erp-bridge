# Copy to .env and fill in. Never commit .env. Load it with your own tooling; the SDK
# reads only the process environment. "__" separates nested settings.

# SAP S/4HANA
S4_BASE_URL=https://myXXXXXX-api.s4hana.ondemand.com
S4_AUTH__TYPE=basic
S4_AUTH__USERNAME=
S4_AUTH__PASSWORD=
S4_SAP_CLIENT=

# SAP ECC (RFC)
ECC_RFC__ASHOST=
ECC_RFC__SYSNR=00
ECC_RFC__CLIENT=100
ECC_RFC__USER=
ECC_RFC__PASSWD=

# Oracle Fusion Cloud ERP
FUSION_BASE_URL=https://XXXX.fa.ocs.oraclecloud.com
FUSION_AUTH__TYPE=basic
FUSION_AUTH__USERNAME=
FUSION_AUTH__PASSWORD=

# Oracle NetSuite (OAuth 2.0 machine-to-machine)
NETSUITE_BASE_URL=https://ACCOUNT.suitetalk.api.netsuite.com
NETSUITE_AUTH__TYPE=oauth2_jwt_assertion
NETSUITE_AUTH__TOKEN_URL=https://ACCOUNT.suitetalk.api.netsuite.com/services/rest/auth/oauth2/v1/token
NETSUITE_AUTH__CLIENT_ID=
NETSUITE_AUTH__KEY_ID=
NETSUITE_AUTH__ALGORITHM=PS256
NETSUITE_AUTH__SCOPES=["rest_webservices"]
# PEM on one line, with \n for line breaks
NETSUITE_AUTH__PRIVATE_KEY=

# Dynamics 365 Finance & Operations
D365_BASE_URL=https://ORG.operations.dynamics.com
D365_COMPANY=usmf
D365_AUTH__TYPE=oauth2_client_credentials
D365_AUTH__TOKEN_URL=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token
D365_AUTH__SCOPE=https://ORG.operations.dynamics.com/.default
D365_AUTH__CLIENT_ID=
D365_AUTH__CLIENT_SECRET=

# Odoo 19+
ODOO_BASE_URL=https://COMPANY.odoo.com
ODOO_DATABASE=
ODOO_AUTH__TYPE=bearer
ODOO_AUTH__TOKEN=

# ERPNext: the key is "api_key:api_secret"
ERPNEXT_BASE_URL=https://SITE.example.com
ERPNEXT_AUTH__TYPE=api_key
ERPNEXT_AUTH__PREFIX="token "
ERPNEXT_AUTH__KEY=

# TallyPrime
TALLY_BASE_URL=http://localhost:9000
TALLY_COMPANY=

# Infor CloudSuite
INFOR_IONAPI_FILE=

# Sage Intacct
INTACCT_AUTH__TYPE=oauth2_client_credentials
INTACCT_AUTH__TOKEN_URL=https://api.intacct.com/ia/api/v1/oauth2/token
INTACCT_AUTH__CLIENT_ID=
INTACCT_AUTH__CLIENT_SECRET=
INTACCT_AUTH__EXTRA_PARAMS={"username": "USER@COMPANY"}

# Webhook example
WEBHOOK_SECRET=
